# Production environment template for ZamZam ERP.
# Copy to `.env` on the server and fill in real values. This differs from
# `.env.example` (which targets local development) in the security- and
# scalability-critical settings called out below.

APP_NAME="ZamZam ERP"
# MUST be `production` (not `local`) and debug MUST be off, or the app leaks
# stack traces and configuration to visitors.
APP_ENV=production
APP_DEBUG=false
APP_KEY=
APP_URL=https://your-domain.com
ASSET_URL=
ADMIN_APP_HOST=app.your-domain.com
TRUSTED_PROXIES=*

APP_VERSION=2.10.1
APP_RELEASE_TYPE=patch
APP_RELEASE_DATE=2026-08-29

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=daily
LOG_DEPRECATIONS_CHANNEL=null
# Keep production logs quiet; `debug` is far too noisy.
LOG_LEVEL=warning

# ---------------------------------------------------------------------------
# Database — DO NOT run production on SQLite.
# SQLite allows only one writer at a time; the storefront, admin panel,
# courier webhooks and scheduled jobs all write concurrently and will hit
# "database is locked" errors under load. Use MySQL 8+ or PostgreSQL.
# ---------------------------------------------------------------------------
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=zamzam_erp
DB_USERNAME=zamzam
DB_PASSWORD=

# Strong password (12+ chars, mixed case, number, symbol) used once by the
# initial `php artisan db:seed`.
ADMIN_NAME="ZamZam Admin"
ADMIN_EMAIL=admin@your-domain.com
ADMIN_PASSWORD=

BACKUP_RETAIN_FILES=10
BACKUP_SCHEDULE_TIME=02:00
GOOGLE_DRIVE_BACKUP_ENABLED=false
GOOGLE_DRIVE_BACKUP_AUTO_UPLOAD=false
GOOGLE_DRIVE_BACKUP_FOLDER_ID=
GOOGLE_DRIVE_SERVICE_ACCOUNT_PATH=
GOOGLE_DRIVE_SERVICE_ACCOUNT_JSON=

# Sessions/cache should not use the local filesystem in a multi-process /
# multi-server deployment. database or redis keeps them consistent.
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
# Do not point this at r2_public. Livewire first needs a local temporary file;
# the final field save writes to R2 after validation and image optimization.
LIVEWIRE_TEMPORARY_UPLOAD_DISK=livewire-tmp

# ---------------------------------------------------------------------------
# Queue — DO NOT use `sync` in production.
# With `sync`, jobs run inside the web request: courier webhooks, the
# external courier fraud check, and the CRM Inbox's AI auto-reply agent
# (up to 6 sequential LLM calls) would all block checkout/webhook responses,
# and job retries/backoff never fire.
# Recommended: `redis` (see docs/deployment.md "Redis on Coolify" for the
# one-click Redis resource + supervised queue-worker setup). `database`
# (needs only the jobs table + a running worker, no extra service) also
# works if a Redis service isn't available yet.
# Run `php artisan queue:work --sleep=1 --tries=3 --max-time=3600` as a
# supervised process (systemd / supervisor / Coolify persistent service)
# either way.
# ---------------------------------------------------------------------------
QUEUE_CONNECTION=redis

# Same Redis service as the queue — caches CRM Inbox AI-agent lookups
# (FAQ/delivery-charge) so they're not re-queried on every AI tool round.
CACHE_STORE=redis

# predis/predis (pure-PHP client, no server extension) is installed —
# REDIS_CLIENT default already matches it in config/database.php.
REDIS_CLIENT=predis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=smtp
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS="admin@your-domain.com"
MAIL_FROM_NAME="${APP_NAME}"

# Meta Cloud API shared by CRM Inbox and storefront WhatsApp templates.
META_GRAPH_API_VERSION=v25.0
META_MAX_MEDIA_BYTES=26214400

# Firebase Cloud Messaging for native Android app-update alerts. Mount the
# service-account JSON as a read-only Coolify secret file and set its absolute
# path here. Never commit the JSON or expose it through a VITE_* variable.
# Use one credential source only; the file path takes precedence.
FIREBASE_PUSH_ENABLED=false
FIREBASE_PROJECT_ID=
FIREBASE_CREDENTIALS=/run/secrets/firebase-service-account.json
# Alternative when the host supports secret values but not secret files:
FIREBASE_CREDENTIALS_JSON_BASE64=

VITE_APP_NAME="${APP_NAME}"
