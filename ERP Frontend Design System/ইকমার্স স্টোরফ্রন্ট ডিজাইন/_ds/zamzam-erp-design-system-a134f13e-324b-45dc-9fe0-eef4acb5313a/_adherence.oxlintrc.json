{
  "plugins": [
    "react",
    "import"
  ],
  "rules": {
    "react/forbid-elements": [
      "warn",
      {
        "forbid": []
      }
    ],
    "no-restricted-imports": [
      "warn",
      {
        "patterns": [
          {
            "group": [
              "components/admin/**",
              "components/storefront/**",
              "ui_kits/admin-dashboard/**",
              "ui_kits/storefront-marketplace-pro/**"
            ],
            "message": "Import design-system components from 'index.js', not component internals."
          }
        ]
      }
    ],
    "no-restricted-syntax": [
      "warn",
      {
        "selector": "Literal[value=/#[0-9a-fA-F]{3,8}\\b/]",
        "message": "Raw hex color — use a design-system color token via var()."
      },
      {
        "selector": "Literal[value=/\\b\\d+px\\b/]",
        "message": "Raw px value — use a design-system spacing token via var()."
      },
      {
        "selector": "Literal[value=/font-family\\s*:\\s*(?!['\\\"]?(?:Inter|Sora))/i]",
        "message": "Font not provided by the design system. Available: Inter, Sora."
      },
      {
        "selector": "JSXOpeningElement[name.name='AdminBadge'] > JSXAttribute > JSXIdentifier[name!=/^(?:children|color|key|ref|className|style|children)$/]",
        "message": "<AdminBadge> doesn't accept that prop. Declared props: children, color."
      },
      {
        "selector": "JSXOpeningElement[name.name='AdminBadge'] > JSXAttribute[name.name='color'] > Literal[value!=/^(?:success|danger|warning|info|gray)$/]",
        "message": "<AdminBadge> color must be one of 'success' | 'danger' | 'warning' | 'info' | 'gray'."
      },
      {
        "selector": "JSXOpeningElement[name.name='AdminButton'] > JSXAttribute > JSXIdentifier[name!=/^(?:children|variant|size|disabled|onClick|key|ref|className|style|children)$/]",
        "message": "<AdminButton> doesn't accept that prop. Declared props: children, variant, size, disabled, onClick."
      },
      {
        "selector": "JSXOpeningElement[name.name='AdminButton'] > JSXAttribute[name.name='variant'] > Literal[value!=/^(?:primary|secondary|danger|ghost)$/]",
        "message": "<AdminButton> variant must be one of 'primary' | 'secondary' | 'danger' | 'ghost'."
      },
      {
        "selector": "JSXOpeningElement[name.name='AdminButton'] > JSXAttribute[name.name='size'] > Literal[value!=/^(?:sm|md|lg)$/]",
        "message": "<AdminButton> size must be one of 'sm' | 'md' | 'lg'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Card'] > JSXAttribute > JSXIdentifier[name!=/^(?:label|value|delta|deltaDirection|icon|key|ref|className|style|children)$/]",
        "message": "<Card> doesn't accept that prop. Declared props: label, value, delta, deltaDirection, icon."
      },
      {
        "selector": "JSXOpeningElement[name.name='Card'] > JSXAttribute[name.name='deltaDirection'] > Literal[value!=/^(?:up|down)$/]",
        "message": "<Card> deltaDirection must be one of 'up' | 'down'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Input'] > JSXAttribute > JSXIdentifier[name!=/^(?:label|placeholder|type|options|key|ref|className|style|children)$/]",
        "message": "<Input> doesn't accept that prop. Declared props: label, placeholder, type, options."
      },
      {
        "selector": "JSXOpeningElement[name.name='Input'] > JSXAttribute[name.name='type'] > Literal[value!=/^(?:text|email|number|select)$/]",
        "message": "<Input> type must be one of 'text' | 'email' | 'number' | 'select'."
      },
      {
        "selector": "JSXOpeningElement[name.name='PriceTag'] > JSXAttribute > JSXIdentifier[name!=/^(?:price|oldPrice|size|key|ref|className|style|children)$/]",
        "message": "<PriceTag> doesn't accept that prop. Declared props: price, oldPrice, size."
      },
      {
        "selector": "JSXOpeningElement[name.name='PriceTag'] > JSXAttribute[name.name='size'] > Literal[value!=/^(?:sm|md|lg)$/]",
        "message": "<PriceTag> size must be one of 'sm' | 'md' | 'lg'."
      },
      {
        "selector": "JSXOpeningElement[name.name='ProductCard'] > JSXAttribute > JSXIdentifier[name!=/^(?:name|price|oldPrice|discount|reviews|inStock|ctaLabel|key|ref|className|style|children)$/]",
        "message": "<ProductCard> doesn't accept that prop. Declared props: name, price, oldPrice, discount, reviews, inStock, ctaLabel."
      },
      {
        "selector": "JSXOpeningElement[name.name='SearchBar'] > JSXAttribute > JSXIdentifier[name!=/^(?:placeholder|key|ref|className|style|children)$/]",
        "message": "<SearchBar> doesn't accept that prop. Declared props: placeholder."
      },
      {
        "selector": "JSXOpeningElement[name.name='SidebarNavItem'] > JSXAttribute > JSXIdentifier[name!=/^(?:label|icon|active|key|ref|className|style|children)$/]",
        "message": "<SidebarNavItem> doesn't accept that prop. Declared props: label, icon, active."
      },
      {
        "selector": "JSXOpeningElement[name.name='StorefrontBadge'] > JSXAttribute > JSXIdentifier[name!=/^(?:children|kind|key|ref|className|style|children)$/]",
        "message": "<StorefrontBadge> doesn't accept that prop. Declared props: children, kind."
      },
      {
        "selector": "JSXOpeningElement[name.name='StorefrontBadge'] > JSXAttribute[name.name='kind'] > Literal[value!=/^(?:discount|save|inStock|tracking)$/]",
        "message": "<StorefrontBadge> kind must be one of 'discount' | 'save' | 'inStock' | 'tracking'."
      },
      {
        "selector": "JSXOpeningElement[name.name='StorefrontButton'] > JSXAttribute > JSXIdentifier[name!=/^(?:children|variant|fullWidth|onClick|key|ref|className|style|children)$/]",
        "message": "<StorefrontButton> doesn't accept that prop. Declared props: children, variant, fullWidth, onClick."
      },
      {
        "selector": "JSXOpeningElement[name.name='StorefrontButton'] > JSXAttribute[name.name='variant'] > Literal[value!=/^(?:primary|secondary|outline)$/]",
        "message": "<StorefrontButton> variant must be one of 'primary' | 'secondary' | 'outline'."
      }
    ]
  },
  "overrides": [
    {
      "files": [
        "**/index.js"
      ],
      "rules": {
        "no-restricted-imports": "off"
      }
    }
  ],
