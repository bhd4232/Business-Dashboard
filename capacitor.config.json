{
  "appId": "com.zamzamint.erp",
  "appName": "ZamZam Dashboard",
  "webDir": "mobile-shell/www",
  "server": {
    "url": "https://app.zamzamint.com",
    "cleartext": false
  },
  "android": {
    "allowMixedContent": false
  },
  "plugins": {
    "PushNotifications": {
      "presentationOptions": [
        "badge",
        "sound",
        "alert"
      ]
    },
    "StatusBar": {
      "overlaysWebView": false,
      "style": "DARK",
      "backgroundColor": "#000000"
    }
  }
}
